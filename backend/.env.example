APP_NAME=QuanLySuKienSinhVienAI API
APP_ENV=development
DEBUG=true

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=QuanLySuKienSinhVien
DATABASE_USER=root
DATABASE_PASSWORD=

JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (gui email)
# Dien thong tin SMTP khi can su dung chuc nang gui email.
# KHONG luu thong tin SMTP that vao file .env.example.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Quan ly Su kien Sinh vien
SMTP_USE_TLS=true